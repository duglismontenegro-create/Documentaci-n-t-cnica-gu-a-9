# ============================================================
# Configuracion de la API - Puesto de Chance
# Copia este archivo como .env y ajusta los valores necesarios.
# ============================================================

# Puerto HTTP en el que escucha la API
PORT=3000

# Secreto usado para firmar los tokens JWT (OBLIGATORIO cambiarlo en produccion)
JWT_SECRET=cambiar-este-secreto-por-uno-seguro

# Vigencia de los tokens JWT (ej: 8h, 30m, 7d)
JWT_EXPIRES_IN=8h

# Zona horaria usada para calcular fechas locales y cierres de caja
ZONA_HORARIA=America/Bogota

# Minutos posteriores a la venta en los que un vendedor puede anular un tiquete
MINUTOS_ANULACION=10

# Minutos antes del sorteo en los que se cierran las ventas
MINUTOS_CIERRE_VENTAS=15

# Valor minimo de una apuesta de chance (en pesos)
APUESTA_MIN_CHANCE=500

# Valor maximo de una apuesta de chance (en pesos)
APUESTA_MAX_CHANCE=50000

# Valor unitario de cada jugada de Baloto (en pesos)
VALOR_BALOTO=5700

# Dias de vigencia de un premio para reclamar el pago
DIAS_CADUCIDAD_PREMIO=365
