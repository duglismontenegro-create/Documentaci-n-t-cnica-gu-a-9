{
  "openapi": "3.0.3",
  "info": {
    "title": "Puesto de Chance API",
    "version": "1.0.0",
    "description": "API REST para la gestión de venta de chance, Baloto, liquidación de premios y cierre de caja de un puesto de lotería. Autenticación mediante JWT y control de acceso por roles (ADMIN / VENDEDOR).",
    "contact": {
      "name": "Equipo de Desarrollo",
      "email": "soporte@puesto-chance.local"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor local de desarrollo"
    }
  ],
  "tags": [
    { "name": "Salud", "description": "Estado del servicio" },
    { "name": "Autenticación", "description": "Inicio de sesión y perfil" },
    { "name": "Sorteos", "description": "Gestión de sorteos y resultados" },
    { "name": "Tiquetes", "description": "Venta, consulta, anulación y pago de tiquetes" },
    { "name": "Caja", "description": "Resumen y cierre de caja diario" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT obtenido en POST /api/v1/auth/login"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Credenciales inválidas" }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 2 },
          "usuario": { "type": "string", "example": "vendedor1" },
          "nombre": { "type": "string", "example": "Ana Pérez" },
          "rol": { "type": "string", "enum": ["ADMIN", "VENDEDOR"], "example": "VENDEDOR" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["usuario", "password"],
        "properties": {
          "usuario": { "type": "string", "example": "vendedor1" },
          "password": { "type": "string", "format": "password", "example": "vende123" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
          "usuario": { "$ref": "#/components/schemas/Usuario" }
        }
      },
      "Sorteo": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "tipo": { "type": "string", "enum": ["CHANCE", "BALOTO"], "example": "CHANCE" },
          "nombre": { "type": "string", "example": "Lotería de Bogotá" },
          "fecha": { "type": "string", "format": "date-time" },
          "estado": { "type": "string", "enum": ["ABIERTO", "JUGADO"], "example": "ABIERTO" },
          "resultado": { "nullable": true, "example": null },
          "acumulado": { "type": "number", "example": 0 }
        }
      },
      "CrearSorteoRequest": {
        "type": "object",
        "required": ["tipo", "nombre", "fecha"],
        "properties": {
          "tipo": { "type": "string", "enum": ["CHANCE", "BALOTO"] },
          "nombre": { "type": "string", "example": "Lotería del Valle" },
          "fecha": { "type": "string", "format": "date-time", "description": "Debe ser una fecha futura" },
          "acumulado": { "type": "number", "description": "Solo aplica para sorteos de tipo BALOTO", "example": 0 }
        }
      },
      "ResultadoChance": {
        "type": "object",
        "required": ["resultado"],
        "properties": {
          "resultado": { "type": "string", "pattern": "^\\d{4}$", "example": "1234" }
        }
      },
      "ResultadoBaloto": {
        "type": "object",
        "required": ["resultado"],
        "properties": {
          "resultado": {
            "type": "object",
            "required": ["numeros", "superbalota"],
            "properties": {
              "numeros": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": { "type": "integer", "minimum": 1, "maximum": 43 },
                "example": [3, 10, 21, 30, 43]
              },
              "superbalota": { "type": "integer", "minimum": 1, "maximum": 16, "example": 7 }
            }
          }
        }
      },
      "ApuestaChance": {
        "type": "object",
        "required": ["numero", "valor"],
        "properties": {
          "numero": { "type": "string", "pattern": "^\\d{1,4}$", "example": "1234" },
          "modalidad": { "type": "string", "enum": ["DIRECTO", "COMBINADO"], "default": "DIRECTO" },
          "valor": { "type": "integer", "description": "Múltiplo de 100, entre el mínimo y máximo configurado", "example": 1000 }
        }
      },
      "JugadaBaloto": {
        "type": "object",
        "description": "Envía { aleatoria: true } para generar la jugada automáticamente.",
        "properties": {
          "aleatoria": { "type": "boolean", "example": false },
          "numeros": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": { "type": "integer", "minimum": 1, "maximum": 43 },
            "example": [1, 2, 3, 4, 5]
          },
          "superbalota": { "type": "integer", "minimum": 1, "maximum": 16, "example": 6 }
        }
      },
      "VenderChanceRequest": {
        "type": "object",
        "required": ["sorteoId", "apuestas"],
        "properties": {
          "sorteoId": { "type": "integer", "example": 1 },
          "cliente": { "type": "string", "nullable": true, "example": "Cliente ocasional" },
          "apuestas": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": { "$ref": "#/components/schemas/ApuestaChance" }
          }
        }
      },
      "VenderBalotoRequest": {
        "type": "object",
        "required": ["sorteoId", "jugadas"],
        "properties": {
          "sorteoId": { "type": "integer", "example": 3 },
          "cliente": { "type": "string", "nullable": true },
          "jugadas": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "$ref": "#/components/schemas/JugadaBaloto" }
          }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "codigo": { "type": "string", "example": "CH-A1B2C3D4" },
          "tipo": { "type": "string", "enum": ["CHANCE", "BALOTO"] },
          "sorteoId": { "type": "integer", "example": 1 },
          "vendedorId": { "type": "integer", "example": 2 },
          "cliente": { "type": "string", "nullable": true },
          "apuestas": { "type": "array", "items": { "$ref": "#/components/schemas/ApuestaChance" } },
          "jugadas": { "type": "array", "items": { "$ref": "#/components/schemas/JugadaBaloto" } },
          "total": { "type": "number", "example": 3000 },
          "estado": { "type": "string", "enum": ["ACTIVO", "ANULADO", "PAGADO", "CADUCADO"] },
          "premio": { "type": "number", "nullable": true, "example": null },
          "creadoEn": { "type": "string", "format": "date-time" }
        }
      },
      "AnularRequest": {
        "type": "object",
        "required": ["motivo"],
        "properties": {
          "motivo": { "type": "string", "example": "Cliente cambió el número" }
        }
      },
      "Pago": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "ticketId": { "type": "integer", "example": 1 },
          "codigo": { "type": "string", "example": "CH-A1B2C3D4" },
          "usuarioId": { "type": "integer", "example": 2 },
          "valor": { "type": "number", "example": 4500000 },
          "fecha": { "type": "string", "format": "date-time" }
        }
      },
      "ResumenCaja": {
        "type": "object",
        "properties": {
          "vendedorId": { "type": "integer", "example": 2 },
          "fecha": { "type": "string", "example": "2026-11-12" },
          "tiquetesVendidos": { "type": "integer", "example": 2 },
          "tiquetesAnulados": { "type": "integer", "example": 0 },
          "ventasChance": { "type": "number", "example": 5000 },
          "ventasBaloto": { "type": "number", "example": 5700 },
          "totalVendido": { "type": "number", "example": 10700 },
          "premiosPagados": { "type": "integer", "example": 0 },
          "totalPagado": { "type": "number", "example": 0 },
          "saldoEsperado": { "type": "number", "example": 10700 },
          "cerrada": { "type": "boolean", "example": false }
        }
      },
      "CierreCajaRequest": {
        "type": "object",
        "required": ["efectivoReportado"],
        "properties": {
          "efectivoReportado": { "type": "integer", "minimum": 0, "example": 10700 },
          "fecha": { "type": "string", "example": "2026-11-12" }
        }
      },
      "CierreCaja": {
        "allOf": [
          { "$ref": "#/components/schemas/ResumenCaja" },
          {
            "type": "object",
            "properties": {
              "id": { "type": "integer", "example": 1 },
              "cerrada": { "type": "boolean", "example": true },
              "efectivoReportado": { "type": "number", "example": 10700 },
              "diferencia": { "type": "number", "example": 0 },
              "estado": { "type": "string", "enum": ["CUADRADA", "SOBRANTE", "FALTANTE"], "example": "CUADRADA" },
              "creadoEn": { "type": "string", "format": "date-time" }
            }
          }
        ]
      }
    },
    "responses": {
      "NoAutorizado": {
        "description": "Token ausente, inválido o expirado",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Prohibido": {
        "description": "El usuario no tiene permisos para la acción",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NoEncontrado": {
        "description": "Recurso no encontrado",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflicto": {
        "description": "Conflicto con el estado actual del recurso",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "SolicitudInvalida": {
        "description": "Datos de entrada inválidos",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Salud"],
        "summary": "Verificar estado del servicio",
        "security": [],
        "responses": {
          "200": {
            "description": "Servicio activo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "estado": { "type": "string", "example": "ok" },
                    "hora": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Iniciar sesión",
        "description": "Valida las credenciales y devuelve un token JWT con el perfil del usuario.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Autenticación exitosa",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } }
          },
          "400": { "$ref": "#/components/responses/SolicitudInvalida" },
          "401": { "$ref": "#/components/responses/NoAutorizado" },
          "403": { "$ref": "#/components/responses/Prohibido" }
        }
      }
    },
    "/api/v1/auth/perfil": {
      "get": {
        "tags": ["Autenticación"],
        "summary": "Obtener perfil del usuario autenticado",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Perfil del usuario",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usuario" } } }
          },
          "401": { "$ref": "#/components/responses/NoAutorizado" }
        }
      }
    },
    "/api/v1/sorteos": {
      "get": {
        "tags": ["Sorteos"],
        "summary": "Listar sorteos",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "query", "name": "tipo", "schema": { "type": "string", "enum": ["CHANCE", "BALOTO"] } },
          { "in": "query", "name": "estado", "schema": { "type": "string", "enum": ["ABIERTO", "JUGADO"] } }
        ],
        "responses": {
          "200": {
            "description": "Lista de sorteos",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Sorteo" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/NoAutorizado" }
        }
      },
      "post": {
        "tags": ["Sorteos"],
        "summary": "Crear un sorteo (solo ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CrearSorteoRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Sorteo creado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sorteo" } } }
          },
          "400": { "$ref": "#/components/responses/SolicitudInvalida" },
          "401": { "$ref": "#/components/responses/NoAutorizado" },
          "403": { "$ref": "#/components/responses/Prohibido" }
        }
      }
    },
    "/api/v1/sorteos/{id}": {
      "get": {
        "tags": ["Sorteos"],
        "summary": "Obtener un sorteo por ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Sorteo encontrado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sorteo" } } }
          },
          "401": { "$ref": "#/components/responses/NoAutorizado" },
          "404": { "$ref": "#/components/responses/NoEncontrado" }
        }
      }
    },
    "/api/v1/sorteos/{id}/resultado": {
      "post": {
        "tags": ["Sorteos"],
        "summary": "Registrar resultado y liquidar premios (solo ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "#/components/schemas/ResultadoChance" },
                  { "$ref": "#/components/schemas/ResultadoBaloto" }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado registrado y tiquetes liquidados",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sorteo" } } }
          },
          "400": { "$ref": "#/components/responses/SolicitudInvalida" },
          "401": { "$ref": "#/components/responses/NoAutorizado" },
          "403": { "$ref": "#/components/responses/Prohibido" },
          "404": { "$ref": "#/components/responses/NoEncontrado" },
          "409": { "$ref": "#/components/responses/Conflicto" }
        }
      }
    },
    "/api/v1/tickets/chance": {
      "post": {
        "tags": ["Tiquetes"],
        "summary": "Vender tiquete de chance (solo VENDEDOR)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VenderChanceRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Tiquete de chance creado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ticket" } } }
          },
          "400": { "$ref": "#/components/responses/SolicitudInvalida" },
          "401": { "$ref": "#/components/responses/NoAutorizado" },
          "403": { "$ref": "#/components/responses/Prohibido" },
          "409": { "$ref": "#/components/responses/Conflicto" }
        }
      }
    },
    "/api/v1/tickets/baloto": {
      "post": {
        "tags": ["Tiquetes"],
        "summary": "Vender tiquete de Baloto (solo VENDEDOR)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VenderBalotoRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Tiquete de Baloto creado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ticket" } } }
          },
          "400": { "$ref": "#/components/responses/SolicitudInvalida" },
          "401": { "$ref": "#/components/responses/NoAutorizado" },
          "403": { "$ref": "#/components/responses/Prohibido" },
          "409": { "$ref": "#/components/responses/Conflicto" }
        }
      }
    },
    "/api/v1/tickets": {
      "get": {
        "tags": ["Tiquetes"],
        "summary": "Listar tiquetes",
        "description": "Un VENDEDOR solo ve sus propios tiquetes; un ADMIN ve todos.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "query", "name": "fecha", "schema": { "type": "string", "example": "2026-11-12" } },
          { "in": "query", "name": "estado", "schema": { "type": "string", "enum": ["ACTIVO", "ANULADO", "PAGADO", "CADUCADO"] } }
        ],
        "responses": {
          "200": {
            "description": "Lista de tiquetes",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Ticket" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/NoAutorizado" }
        }
      }
    },
    "/api/v1/tickets/{codigo}": {
      "get": {
        "tags": ["Tiquetes"],
        "summary": "Consultar un tiquete por código",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "codigo", "required": true, "schema": { "type": "string" }, "example": "CH-A1B2C3D4" }
        ],
        "responses": {
          "200": {
            "description": "Tiquete con información del sorteo y estado de ganador",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ticket" } } }
          },
          "401": { "$ref": "#/components/responses/NoAutorizado" },
          "404": { "$ref": "#/components/responses/NoEncontrado" }
        }
      }
    },
    "/api/v1/tickets/{codigo}/anular": {
      "post": {
        "tags": ["Tiquetes"],
        "summary": "Anular un tiquete",
        "description": "El vendedor dueño o un ADMIN pueden anular. El vendedor tiene una ventana de tiempo configurable.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "codigo", "required": true, "schema": { "type": "string" }, "example": "CH-A1B2C3D4" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnularRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Tiquete anulado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ticket" } } }
          },
          "401": { "$ref": "#/components/responses/NoAutorizado" },
          "403": { "$ref": "#/components/responses/Prohibido" },
          "404": { "$ref": "#/components/responses/NoEncontrado" },
          "409": { "$ref": "#/components/responses/Conflicto" }
        }
      }
    },
    "/api/v1/tickets/{codigo}/pagar": {
      "post": {
        "tags": ["Tiquetes"],
        "summary": "Pagar el premio de un tiquete (solo VENDEDOR)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "codigo", "required": true, "schema": { "type": "string" }, "example": "CH-A1B2C3D4" }
        ],
        "responses": {
          "200": {
            "description": "Pago registrado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pago" } } }
          },
          "401": { "$ref": "#/components/responses/NoAutorizado" },
          "403": { "$ref": "#/components/responses/Prohibido" },
          "404": { "$ref": "#/components/responses/NoEncontrado" },
          "409": { "$ref": "#/components/responses/Conflicto" },
          "410": {
            "description": "El premio está caducado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/v1/caja/resumen": {
      "get": {
        "tags": ["Caja"],
        "summary": "Consultar resumen de caja diario",
        "description": "Un VENDEDOR consulta su propia caja; un ADMIN puede indicar vendedorId.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "query", "name": "fecha", "schema": { "type": "string", "example": "2026-11-12" } },
          { "in": "query", "name": "vendedorId", "description": "Solo válido para ADMIN", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Resumen de caja",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResumenCaja" } } }
          },
          "401": { "$ref": "#/components/responses/NoAutorizado" }
        }
      }
    },
    "/api/v1/caja/cierre": {
      "post": {
        "tags": ["Caja"],
        "summary": "Cerrar la caja del día (solo VENDEDOR)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CierreCajaRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Cierre de caja registrado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CierreCaja" } } }
          },
          "400": { "$ref": "#/components/responses/SolicitudInvalida" },
          "401": { "$ref": "#/components/responses/NoAutorizado" },
          "403": { "$ref": "#/components/responses/Prohibido" },
          "409": { "$ref": "#/components/responses/Conflicto" }
        }
      }
    }
  }
}
